# ==========================================
# ComicCraft Environment Configuration
# ==========================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Names (Fast and high quota models)
GEMINI_FLASH_MODEL=gemini-flash-lite-latest
GEMINI_PRO_MODEL=gemini-3.8-flash

# Hugging Face API Key (optional; a token with Inference Providers permission)
# Create one at https://huggingface.co/settings/tokens. Never commit a real token.
HF_API_KEY=your_huggingface_api_key_here
# Optional custom model endpoint; defaults to Hugging Face's supported SD 3 Medium inference model.
# HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models/stabilityai/stable-diffusion-3-medium-diffusers

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
